<UserControl x:Class="DatingApp.Desktop.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DatingApp.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:OnboardingViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#09090B">

    <!-- Premium Aura Taste Styles -->
    <UserControl.Resources>
        <Style x:Key="PremiumCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="HeadingStyle">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style TargetType="TextBlock" x:Key="SubHeadingStyle">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Margin" Value="0,0,0,40"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="#E6005C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1A75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="OutlineButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E6005C"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="28" BorderBrush="#E6005C" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button for Selections -->
        <Style TargetType="ToggleButton" x:Key="ChipToggleButton">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="24" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#E6005C"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#E6005C"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Value Converters for Steps -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Background Decor -->
        <Ellipse Width="800" Height="800" Fill="#E6005C" Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-200,0">
            <Ellipse.Effect>
                <BlurEffect Radius="200"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="600" Height="600" Fill="#7C3AED" Opacity="0.05" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,-150">
            <Ellipse.Effect>
                <BlurEffect Radius="200"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Progress Bar at Top -->
        <ProgressBar Value="{Binding CurrentProgress}" Height="4" VerticalAlignment="Top" Background="#27272A" Foreground="#E6005C" BorderThickness="0" Minimum="0" Maximum="100"/>

        <!-- Main Content -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="600">
            <Border Style="{StaticResource PremiumCardStyle}">
                <Grid>
                    <!-- STEP 1: GENDER & PREFERENCE -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <TextBlock Text="Bạn là ai?" Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Text="Hãy chia sẻ thêm về bản thân để có những gợi ý tốt nhất." Style="{StaticResource SubHeadingStyle}"/>
                        
                        <TextBlock Text="Giới tính của bạn" Foreground="#FAFAFA" FontSize="15" FontWeight="Medium" Margin="0,0,0,16"/>
                        <ComboBox SelectedIndex="{Binding SelectedGenderIndex}" 
                                  materialDesign:HintAssist.Hint="Chọn giới tính"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,32" Height="56" FontSize="16">
                            <ComboBoxItem Content="Nam"/>
                            <ComboBoxItem Content="Nữ"/>
                            <ComboBoxItem Content="Khác"/>
                        </ComboBox>

                        <TextBlock Text="Bạn muốn tìm kiếm?" Foreground="#FAFAFA" FontSize="15" FontWeight="Medium" Margin="0,0,0,16"/>
                        <ComboBox SelectedIndex="{Binding SelectedInterestedInIndex}" 
                                  materialDesign:HintAssist.Hint="Gu của bạn"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,32" Height="56" FontSize="16">
                            <ComboBoxItem Content="Nam"/>
                            <ComboBoxItem Content="Nữ"/>
                            <ComboBoxItem Content="Mọi người"/>
                        </ComboBox>
                        
                        <Button Content="Tiếp tục" Command="{Binding NextStepCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,20,0,0"/>
                    </StackPanel>

                    <!-- STEP 2: DETAILS -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Ngoại hình &amp; Lối sống" Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Text="Điền thông tin này giúp hồ sơ bạn hoàn thiện hơn." Style="{StaticResource SubHeadingStyle}"/>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Chiều cao (cm)" Foreground="#FAFAFA" FontSize="15" FontWeight="Medium" Margin="0,0,0,12"/>
                                <TextBox Text="{Binding Height}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="White" BorderBrush="#3F3F46" Height="56" FontSize="16"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Học vấn / Nghề nghiệp" Foreground="#FAFAFA" FontSize="15" FontWeight="Medium" Margin="0,0,0,12"/>
                                <TextBox Text="{Binding Education}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="VD: Sinh viên, IT..."
                                         Foreground="White" BorderBrush="#3F3F46" Height="56" FontSize="16"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Bạn có hút thuốc không?" Foreground="#FAFAFA" FontSize="15" FontWeight="Medium" Margin="0,0,0,16"/>
                        <ComboBox SelectedIndex="{Binding SmokingIndex}" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,24" Height="56" FontSize="16">
                            <ComboBoxItem Content="Không bao giờ"/>
                            <ComboBoxItem Content="Thỉnh thoảng"/>
                            <ComboBoxItem Content="Thường xuyên"/>
                        </ComboBox>

                        <TextBlock Text="Bạn có hay nhậu nhẹt?" Foreground="#FAFAFA" FontSize="15" FontWeight="Medium" Margin="0,0,0,16"/>
                        <ComboBox SelectedIndex="{Binding DrinkingIndex}" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,32" Height="56" FontSize="16">
                            <ComboBoxItem Content="Không uống"/>
                            <ComboBoxItem Content="Xã giao"/>
                            <ComboBoxItem Content="Thường xuyên"/>
                        </ComboBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Quay lại" Command="{Binding PrevStepCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                            <Button Grid.Column="2" Content="Tiếp tục" Command="{Binding NextStepCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- STEP 3: INTERESTS & BIO -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Sở thích của bạn" Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Text="Một chút thông tin về điều bạn yêu thích." Style="{StaticResource SubHeadingStyle}"/>

                        <TextBlock Text="Bio (Giới thiệu bản thân)" Foreground="#FAFAFA" FontSize="15" FontWeight="Medium" Margin="0,0,0,16"/>
                        <TextBox Text="{Binding Bio}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="100" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,32" FontSize="16"/>

                        <TextBlock Text="Chọn các Tag sở thích" Foreground="#FAFAFA" FontSize="15" FontWeight="Medium" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding AvailableInterests}" Margin="0,0,0,32">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding IsSelected}" Content="{Binding Name}" Style="{StaticResource ChipToggleButton}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Quay lại" Command="{Binding PrevStepCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                            <Button Grid.Column="2" Content="Tiếp tục" Command="{Binding NextStepCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- STEP 4: FINISH -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="80" Height="80" Foreground="#E6005C" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <TextBlock Text="Sẵn sàng ghép đôi!" Style="{StaticResource HeadingStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hồ sơ của bạn đã hoàn thiện. Hãy tải lên Avatar ở phần Profile để tăng 100% khả năng hiển thị nhé." 
                                   TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SubHeadingStyle}"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Quay lại" Command="{Binding PrevStepCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                            <Button Grid.Column="2" Content="Bắt đầu ngay" Command="{Binding CompleteOnboardingCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content" Value="Đang lưu..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
