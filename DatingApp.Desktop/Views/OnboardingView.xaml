<UserControl x:Class="DatingApp.Desktop.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DatingApp.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:OnboardingViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F0F2F5">

    <UserControl.Resources>
        <!-- Premium Onboarding Card Style -->
        <Style x:Key="OnboardingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E4E6EB"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="45" ShadowDepth="10" Color="Black" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="HeadingStyle">
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#1C1E21"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style TargetType="TextBlock" x:Key="SubHeadingStyle">
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#65676B"/>
            <Setter Property="Margin" Value="0,0,0,32"/>
        </Style>

        <!-- Toggle Button for Selections (Chips) -->
        <Style TargetType="ToggleButton" x:Key="ChipToggleButton">
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="Foreground" Value="#65676B"/>
            <Setter Property="BorderBrush" Value="#E4E6EB"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="21" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#FFF0F5"/>
                                <Setter Property="Foreground" Value="#E6005C"/>
                                <Setter Property="BorderBrush" Value="#E6005C"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#E4E6EB"/>
                                <Setter Property="Foreground" Value="#1C1E21"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Smooth slide-up and fade-in transition for wizard steps -->
        <Style x:Key="FadeInPanelStyle" TargetType="FrameworkElement">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Mesh background glows -->
        <Ellipse Width="800" Height="800" Fill="#FF1A75" Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-200,0">
            <Ellipse.Effect>
                <BlurEffect Radius="180"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="600" Height="600" Fill="#FF6EA7" Opacity="0.05" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,-150">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Progress Bar at Top -->
        <ProgressBar Value="{Binding CurrentProgress}" Height="5" VerticalAlignment="Top" Background="#E4E6EB" Foreground="{StaticResource FbBrandGradient}" BorderThickness="0" Minimum="0" Maximum="100"/>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,15,0,0">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" Margin="0,30">
                <Border Style="{StaticResource OnboardingCardStyle}">
                    <Grid>
                        <!-- STEP 1: GENDER & PREFERENCE -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel" BasedOn="{StaticResource FadeInPanelStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <TextBlock Text="Bạn là ai?" Style="{StaticResource HeadingStyle}"/>
                            <TextBlock Text="Hãy chia sẻ thêm về bản thân để có những gợi ý tốt nhất." Style="{StaticResource SubHeadingStyle}"/>
                            
                            <TextBlock Text="Bạn muốn tìm kiếm?" Foreground="#1C1E21" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ComboBox SelectedIndex="{Binding SelectedInterestedInIndex}" 
                                      materialDesign:HintAssist.Hint="Gu của bạn"
                                      Style="{StaticResource PremiumComboBox}"
                                      Margin="0,0,0,28" Height="50" FontSize="15">
                                <ComboBoxItem Content="Nam"/>
                                <ComboBoxItem Content="Nữ"/>
                                <ComboBoxItem Content="Mọi người"/>
                            </ComboBox>
                            
                            <Button Content="Tiếp tục" Command="{Binding NextStepCommand}" Style="{StaticResource PremiumButton}" Margin="0,16,0,0"/>
                        </StackPanel>

                        <!-- STEP 2: DETAILS -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel" BasedOn="{StaticResource FadeInPanelStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Ngoại hình &amp; Lối sống" Style="{StaticResource HeadingStyle}"/>
                            <TextBlock Text="Điền thông tin này giúp hồ sơ bạn hoàn thiện hơn." Style="{StaticResource SubHeadingStyle}"/>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Chiều cao (cm)" Foreground="#1C1E21" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBox Text="{Binding Height}" Style="{StaticResource PremiumTextBox}" Height="50" FontSize="15"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Học vấn / Nghề nghiệp" Foreground="#1C1E21" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBox Text="{Binding Education}" Style="{StaticResource PremiumTextBox}"
                                             materialDesign:HintAssist.Hint="VD: Sinh viên, IT..." Height="50" FontSize="15"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Bạn có hút thuốc không?" Foreground="#1C1E21" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ComboBox SelectedIndex="{Binding SmokingIndex}" 
                                      Style="{StaticResource PremiumComboBox}"
                                      Margin="0,0,0,24" Height="50" FontSize="15">
                                <ComboBoxItem Content="Không bao giờ"/>
                                <ComboBoxItem Content="Thỉnh thoảng"/>
                                <ComboBoxItem Content="Thường xuyên"/>
                            </ComboBox>

                            <TextBlock Text="Bạn có hay nhậu nhẹt?" Foreground="#1C1E21" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ComboBox SelectedIndex="{Binding DrinkingIndex}" 
                                      Style="{StaticResource PremiumComboBox}"
                                      Margin="0,0,0,28" Height="50" FontSize="15">
                                <ComboBoxItem Content="Không uống"/>
                                <ComboBoxItem Content="Xã giao"/>
                                <ComboBoxItem Content="Thường xuyên"/>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Quay lại" Command="{Binding PrevStepCommand}" Style="{StaticResource PremiumOutlineButton}"/>
                                <Button Grid.Column="2" Content="Tiếp tục" Command="{Binding NextStepCommand}" Style="{StaticResource PremiumButton}"/>
                            </Grid>
                        </StackPanel>

                        <!-- STEP 3: INTERESTS & BIO -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel" BasedOn="{StaticResource FadeInPanelStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Sở thích của bạn" Style="{StaticResource HeadingStyle}"/>
                            <TextBlock Text="Một chút thông tin về điều bạn yêu thích." Style="{StaticResource SubHeadingStyle}"/>

                            <TextBlock Text="Bio (Giới thiệu bản thân)" Foreground="#1C1E21" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding Bio}" 
                                     Style="{StaticResource PremiumTextBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Height="90" Margin="0,0,0,28" FontSize="15"/>

                            <TextBlock Text="Chọn các Tag sở thích" Foreground="#1C1E21" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding AvailableInterests}" Margin="0,0,0,28">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsSelected}" Content="{Binding Name}" Style="{StaticResource ChipToggleButton}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Quay lại" Command="{Binding PrevStepCommand}" Style="{StaticResource PremiumOutlineButton}"/>
                                <Button Grid.Column="2" Content="Tiếp tục" Command="{Binding NextStepCommand}" Style="{StaticResource PremiumButton}"/>
                            </Grid>
                        </StackPanel>

                        <!-- STEP 4: FINISH -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel" BasedOn="{StaticResource FadeInPanelStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="80" Height="80" Foreground="#E6005C" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="Sẵn sàng ghép đôi!" Style="{StaticResource HeadingStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hồ sơ của bạn đã hoàn thiện. Hãy tải lên Avatar ở phần Profile để tăng 100% khả năng hiển thị nhé." 
                                       TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SubHeadingStyle}"/>

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="13" FontWeight="SemiBold"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Quay lại" Command="{Binding PrevStepCommand}" Style="{StaticResource PremiumOutlineButton}"/>
                                <Button Grid.Column="2" Content="Bắt đầu ngay" Command="{Binding CompleteOnboardingCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PremiumButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Content" Value="Đang lưu..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
