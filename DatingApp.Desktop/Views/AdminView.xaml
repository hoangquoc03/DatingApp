<UserControl x:Class="DatingApp.Desktop.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DatingApp.Desktop.ViewModels"
             xmlns:converters="clr-namespace:DatingApp.Desktop.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:AdminViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="700">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ToggleStatusConverter x:Key="ToggleStatusConverter"/>
        <converters:ToggleColorConverter x:Key="ToggleColorConverter"/>
        <converters:InitialsConverter x:Key="InitialsConverter"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFF5F8" Padding="24,16" BorderBrush="#FFD6E7" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Security" Width="32" Height="32" Foreground="#E6005C" Margin="0,0,16,0"/>
                    <TextBlock Text="Quản trị Hệ thống" FontSize="24" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                    <Button Command="{Binding LoadUsersCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Làm mới" Margin="20,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsUserTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="Refresh" Foreground="#6B7280"/>
                    </Button>
                    <Button Command="{Binding LoadReportsCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Làm mới" Margin="20,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsReportTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="Refresh" Foreground="#6B7280"/>
                    </Button>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 IsChecked="{Binding IsUserTabSelected}"
                                 Command="{Binding SelectUserTabCommand}"
                                 Content="Người dùng" 
                                 Margin="0,0,10,0"/>
                    <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 IsChecked="{Binding IsReportTabSelected}"
                                 Command="{Binding SelectReportTabCommand}"
                                 Content="Báo cáo vi phạm"/>
                </StackPanel>

                <!-- Logout Button -->
                <Button Grid.Column="2" Command="{Binding LogoutCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#EF4444" Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đăng xuất" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- STATS DASHBOARD -->
        <Border Grid.Row="1" Background="White" Margin="24,24,24,0" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <UniformGrid Columns="6">
                <StackPanel>
                    <TextBlock Text="Tổng Users" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalUsers}" FontSize="24" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Đang hoạt động" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveUsers}" FontSize="24" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Đã xác thực" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding VerifiedUsers}" FontSize="24" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Số lượt Match" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalMatches}" FontSize="24" FontWeight="Bold" Foreground="#E6005C" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Tổng Báo cáo" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalReports}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Báo cáo chờ xử lý" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding UnresolvedReports}" FontSize="24" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Top" Foreground="#E6005C"/>

        <!-- Users Data Grid -->
        <DataGrid Grid.Row="2" Margin="24" ItemsSource="{Binding Users}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" 
                  Style="{StaticResource MaterialDesignDataGrid}" Background="White"
                  Visibility="{Binding IsUserTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid.Columns>
                <!-- Avatar -->
                <DataGridTemplateColumn Header="Avatar">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="40" Height="40" Margin="4">
                                <!-- Fallback initials background -->
                                <Ellipse Fill="#FFD6E7"/>
                                <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="Bold" FontSize="14" Foreground="#E6005C"/>
                                
                                <!-- Real Avatar Image -->
                                <Ellipse x:Name="AvatarEllipse" Width="40" Height="40" Visibility="{Binding AvatarUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Online Status Badge -->
                                <Ellipse Width="10" Height="10" Fill="#10B981" 
                                         Stroke="White" StrokeThickness="1.5"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,1,1"
                                         Visibility="{Binding IsOnline, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleDisplay}" Width="100"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="100"/>
                
                <DataGridTemplateColumn Header="Xác thực" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="DecagramOutline"/>
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                <Setter Property="Kind" Value="CheckDecagram"/>
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Ngày tham gia" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                
                <!-- Actions -->
                <DataGridTemplateColumn Header="Thao tác" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding IsActive, Converter={StaticResource ToggleStatusConverter}}"
                                        Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="{Binding IsActive, Converter={StaticResource ToggleColorConverter}}"
                                        Padding="4" Margin="0,0,5,0"/>

                                <Button Command="{Binding DataContext.ToggleUserVerifyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="28" Height="28" Margin="0,0,5,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="ToolTip" Value="Cấp tích xanh"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                    <Setter Property="ToolTip" Value="Hủy tích xanh"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Width="18" Height="18">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="DecagramOutline"/>
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                        <Setter Property="Kind" Value="CheckDecagram"/>
                                                        <Setter Property="Foreground" Value="#3B82F6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                                
                                <Button Command="{Binding DataContext.ToggleUserRoleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="28" Height="28" Margin="0,0,5,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="ToolTip" Value="Thăng chức Admin"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="1">
                                                    <Setter Property="ToolTip" Value="Hạ chức xuống User"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Width="18" Height="18">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="ShieldKeyOutline"/>
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="1">
                                                        <Setter Property="Kind" Value="ShieldKey"/>
                                                        <Setter Property="Foreground" Value="#E6005C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>

                                <Button Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignIconButton}" ToolTip="Xóa" Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="Delete" Foreground="#EF4444"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Reports Data Grid -->
        <DataGrid Grid.Row="2" Margin="24" ItemsSource="{Binding Reports}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" 
                  Style="{StaticResource MaterialDesignDataGrid}" Background="White"
                  Visibility="{Binding IsReportTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="60"/>
                
                <!-- Reporter -->
                <DataGridTemplateColumn Header="Người báo cáo" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <Grid Width="30" Height="30" Margin="0,0,10,0">
                                    <Ellipse Fill="#E2E8F0"/>
                                    <TextBlock Text="{Binding Reporter.FullName, Converter={StaticResource InitialsConverter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                                    
                                    <!-- Real Avatar Image -->
                                    <Ellipse Width="30" Height="30" Visibility="{Binding Reporter.AvatarUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Reporter.AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Online Status Badge -->
                                    <Ellipse Width="8" Height="8" Fill="#10B981" 
                                             Stroke="White" StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Visibility="{Binding Reporter.IsOnline, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Reporter.FullName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1F2937"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Reported User -->
                <DataGridTemplateColumn Header="Người bị báo cáo" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <Grid Width="30" Height="30" Margin="0,0,10,0">
                                    <Ellipse Fill="#FEE2E2"/>
                                    <TextBlock Text="{Binding ReportedUser.FullName, Converter={StaticResource InitialsConverter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Bold" FontSize="11" Foreground="#EF4444"/>
                                    
                                    <!-- Real Avatar Image -->
                                    <Ellipse Width="30" Height="30" Visibility="{Binding ReportedUser.AvatarUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ReportedUser.AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Online Status Badge -->
                                    <Ellipse Width="8" Height="8" Fill="#10B981" 
                                             Stroke="White" StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Visibility="{Binding ReportedUser.IsOnline, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding ReportedUser.FullName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1F2937"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Lý do" Binding="{Binding ReasonDisplay}" Width="130"/>
                <DataGridTextColumn Header="Chi tiết" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="100"/>
                <DataGridTextColumn Header="Ngày báo cáo" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>

                <!-- Actions -->
                <DataGridTemplateColumn Header="Thao tác" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- Resolve Button -->
                                <Button Content="Giải quyết"
                                        Command="{Binding DataContext.ResolveReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsPending}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#10B981"
                                        Padding="4" Margin="0,0,5,0"/>

                                <!-- Ban/Unban Reported User Button -->
                                <Button Content="Khóa/Mở khóa"
                                        Command="{Binding DataContext.ToggleReportedUserActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#EF4444"
                                        Padding="4"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
