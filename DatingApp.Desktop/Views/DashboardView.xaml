<UserControl x:Class="DatingApp.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DatingApp.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#FFF5F8"> <!-- Soft Pinkish White Background -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="White" CornerRadius="0,20,20,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="5" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Logo -->
                <StackPanel Grid.Row="0" Margin="0,0,0,40">
                    <TextBlock Text="Aura Premium" FontSize="26" FontWeight="ExtraBold" Foreground="#E6005C" FontFamily="Segoe UI"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <Button Command="{Binding ShowDiscoverCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{Binding DiscoverTabColor}" HorizontalContentAlignment="Left" Padding="15,12" Margin="0,0,0,10" Height="Auto" MinHeight="50">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CardsHeart" Width="26" Height="26" Margin="0,0,16,0"/>
                            <TextBlock Text="Khám phá" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowMessagesCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{Binding MessagesTabColor}" HorizontalContentAlignment="Left" Padding="15,12" Margin="0,0,0,10" Height="Auto" MinHeight="50">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="MessageText" Width="26" Height="26" Margin="0,0,16,0"/>
                            <TextBlock Text="Tin nhắn" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowProfileCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{Binding ProfileTabColor}" HorizontalContentAlignment="Left" Padding="15,12" Margin="0,0,0,10" Height="Auto" MinHeight="50">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Account" Width="26" Height="26" Margin="0,0,16,0"/>
                            <TextBlock Text="Hồ sơ" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <!-- Admin Button -->
                    <Button Command="{Binding OpenAdminCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#1F2937" HorizontalContentAlignment="Left" Padding="15,12" Height="Auto" MinHeight="50">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Security" Width="26" Height="26" Margin="0,0,16,0"/>
                            <TextBlock Text="Quản trị viên" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer Profile -->
                <Border Grid.Row="2" Background="#FFF1F6" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Fake Avatar -->
                        <Ellipse Width="40" Height="40" Fill="#FF5C9A" Grid.Column="0" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tài khoản của bạn" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock Text="Chỉnh sửa thông tin" FontSize="12" Foreground="#E6005C" Margin="0,2,0,0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- DISCOVER AREA -->
        <Grid Grid.Column="1" Visibility="{Binding IsDiscoverVisible, Converter={StaticResource BoolToVis}}" Background="#FFF5F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Bộ lọc Tìm kiếm -->
            <Expander Grid.Row="0" Header="Bộ lọc tìm kiếm" Background="White" Margin="20,20,20,0" BorderThickness="0">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Độ tuổi" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Từ" Text="{Binding FilterAgeMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="40"/>
                            <TextBlock Grid.Column="1" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Đến" Text="{Binding FilterAgeMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="40"/>
                        </Grid>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Giới tính" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ComboBox Text="{Binding FilterGender, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40">
                                    <ComboBoxItem Content="Tất cả"/>
                                    <ComboBoxItem Content="Nam"/>
                                    <ComboBoxItem Content="Nữ"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Khoảng cách (km)" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBox materialDesign:HintAssist.Hint="Max km" Text="{Binding FilterMaxDistance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="40"/>
                            </StackPanel>
                        </Grid>
                        
                        <Button Content="Áp dụng bộ lọc" Command="{Binding ApplyFiltersCommand}" Background="#E6005C" BorderBrush="Transparent" Margin="0,15,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- Card Stack (Tinder Style) -->
            <Grid Grid.Row="1" Width="400" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="SwipeCard" Width="380" Height="600" CornerRadius="28" Background="White" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="SwipeCard_MouseLeftButtonDown"
                    MouseMove="SwipeCard_MouseMove"
                    MouseLeftButtonUp="SwipeCard_MouseLeftButtonUp"
                    Cursor="Hand">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="CardTranslate" X="0" Y="0" />
                        <RotateTransform x:Name="CardRotate" Angle="0" CenterX="190" CenterY="650" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="20" Opacity="0.12" Color="#111827"/>
                </Border.Effect>
                <Grid>
                    <!-- Background Image -->
                    <Border CornerRadius="28" ClipToBounds="True">
                        <Image Source="{Binding CurrentUserImage, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                    </Border>
                    
                    <!-- Gradient Overlay for Text Readability -->
                    <Border CornerRadius="28">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#E6000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Info -->
                    <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,110">
                        <TextBlock Text="{Binding CurrentUserName}" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CurrentUserBio}" FontSize="18" FontWeight="Medium" Foreground="#E5E7EB" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30">
                        <!-- PASS Button -->
                        <Button x:Name="BtnPass" Command="{Binding PassCommand}" 
                                Style="{StaticResource MaterialDesignFloatingActionLightButton}" 
                                Background="White" BorderBrush="White" Width="72" Height="72" Margin="0,0,30,0">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.15" Color="Black"/>
                            </Button.Effect>
                            <materialDesign:PackIcon Kind="Close" Width="42" Height="42" Foreground="#4B5563"/>
                        </Button>

                        <!-- LIKE Button -->
                        <Button x:Name="BtnLike" Command="{Binding LikeCommand}" 
                                Style="{StaticResource MaterialDesignFloatingActionLightButton}" 
                                Background="White" BorderBrush="White" Width="72" Height="72">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.15" Color="Black"/>
                            </Button.Effect>
                            <materialDesign:PackIcon Kind="Heart" Width="40" Height="40" Foreground="#E6005C"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
            
            <!-- Hiệu ứng thông báo Match -->
            <Border x:Name="MatchPopup" Visibility="{Binding IsMatchPopupVisible, Converter={StaticResource BoolToVis}}" Background="#CC000000" CornerRadius="24" Width="400" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CardsHeart" Width="100" Height="100" Foreground="#FF5C9A" HorizontalAlignment="Center"/>
                    <TextBlock Text="IT'S A MATCH!" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                    <Button Content="Tiếp tục" Width="150" Margin="0,30,0,0" Command="{Binding CloseMatchPopupCommand}" Background="#FF5C9A" BorderBrush="Transparent"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- PROFILE AREA -->
        <Grid Grid.Column="1" Visibility="{Binding IsProfileVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Chỉnh sửa Hồ sơ" FontSize="28" FontWeight="Bold" Foreground="#1F2937" Margin="40,40,0,10"/>
            
            <StackPanel Margin="40,0,40,20">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Độ hoàn thiện hồ sơ" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding ProfileCompletionScore, StringFormat={}{0}%}" FontSize="14" FontWeight="Bold" Foreground="#E6005C" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Value="{Binding ProfileCompletionScore}" Height="8" Minimum="0" Maximum="100" Background="#E5E7EB" Foreground="#E6005C" BorderThickness="0"/>
                <TextBlock Text="Hoàn thiện hồ sơ để tăng 100% khả năng hiển thị!" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProfileComplete}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,0,40,40" MaxWidth="500" HorizontalAlignment="Left">
                    <!-- Avatar -->
                    <Border Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ProfileAvatarUrl, TargetNullValue='pack://application:,,,/Resources/default-avatar.jpg', FallbackValue='pack://application:,,,/Resources/default-avatar.jpg'}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Button Content="Đổi ảnh đại diện" Command="{Binding UploadAvatarCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#E6005C" BorderBrush="#E6005C" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                    
                    <!-- Thư viện ảnh -->
                    <TextBlock Text="Thư viện ảnh" FontSize="16" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ProfilePhotos}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,10,10">
                                    <Border Width="100" Height="100" CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Url, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5">
                                        <Button Command="{Binding DataContext.SetMainPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#10B981" BorderBrush="Transparent" Width="24" Height="24" Padding="0" Margin="0,0,5,0" ToolTip="Đặt làm ảnh chính">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="Check" Width="14" Height="14" Foreground="White"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeletePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#EF4444" BorderBrush="Transparent" Width="24" Height="24" Padding="0" ToolTip="Xoá ảnh">
                                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="White"/>
                                        </Button>
                                    </StackPanel>
                                    <Border Background="#10B981" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5" Visibility="{Binding IsMain, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Ảnh chính" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Thêm ảnh vào thư viện" Command="{Binding AddPhotoCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E6005C" HorizontalAlignment="Left" Margin="0,0,0,30">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ImageAdd" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    
                    <!-- Form -->
                    <TextBox materialDesign:HintAssist.Hint="Họ và tên" Text="{Binding ProfileFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,20"/>
                    <TextBox materialDesign:HintAssist.Hint="Giới thiệu bản thân (Bio)" Text="{Binding ProfileBio, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" TextWrapping="Wrap" AcceptsReturn="True" Height="100" Margin="0,0,0,20"/>
                    
                    <ComboBox materialDesign:HintAssist.Hint="Giới tính" Text="{Binding ProfileGender, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,20">
                        <ComboBoxItem Content="Nam"/>
                        <ComboBoxItem Content="Nữ"/>
                        <ComboBoxItem Content="Khác"/>
                    </ComboBox>
                    
                    <DatePicker materialDesign:HintAssist.Hint="Ngày sinh" SelectedDate="{Binding ProfileDateOfBirth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,20"/>
                    
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Chiều cao (cm)" Text="{Binding ProfileHeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Học vấn" Text="{Binding ProfileEducation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Nghề nghiệp" Text="{Binding ProfileOccupation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Địa điểm (Thành phố)" Text="{Binding ProfileLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Hút thuốc" Text="{Binding ProfileSmoking, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="Không"/>
                            <ComboBoxItem Content="Thỉnh thoảng"/>
                            <ComboBoxItem Content="Thường xuyên"/>
                        </ComboBox>
                        <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Nhậu nhẹt" Text="{Binding ProfileDrinking, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="Không"/>
                            <ComboBoxItem Content="Xã giao"/>
                            <ComboBoxItem Content="Thường xuyên"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Cung Hoàng Đạo" Text="{Binding ProfileZodiac, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="Bạch Dương"/>
                            <ComboBoxItem Content="Kim Ngưu"/>
                            <ComboBoxItem Content="Song Tử"/>
                            <ComboBoxItem Content="Cự Giải"/>
                            <ComboBoxItem Content="Sư Tử"/>
                            <ComboBoxItem Content="Xử Nữ"/>
                            <ComboBoxItem Content="Thiên Bình"/>
                            <ComboBoxItem Content="Bọ Cạp"/>
                            <ComboBoxItem Content="Nhân Mã"/>
                            <ComboBoxItem Content="Ma Kết"/>
                            <ComboBoxItem Content="Bảo Bình"/>
                            <ComboBoxItem Content="Song Ngư"/>
                        </ComboBox>
                        <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="MBTI" Text="{Binding ProfileMbti, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="INTJ"/>
                            <ComboBoxItem Content="INTP"/>
                            <ComboBoxItem Content="ENTJ"/>
                            <ComboBoxItem Content="ENTP"/>
                            <ComboBoxItem Content="INFJ"/>
                            <ComboBoxItem Content="INFP"/>
                            <ComboBoxItem Content="ENFJ"/>
                            <ComboBoxItem Content="ENFP"/>
                            <ComboBoxItem Content="ISTJ"/>
                            <ComboBoxItem Content="ISFJ"/>
                            <ComboBoxItem Content="ESTJ"/>
                            <ComboBoxItem Content="ESFJ"/>
                            <ComboBoxItem Content="ISTP"/>
                            <ComboBoxItem Content="ISFP"/>
                            <ComboBoxItem Content="ESTP"/>
                            <ComboBoxItem Content="ESFP"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Đang tìm kiếm" Text="{Binding ProfileLookingFor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="Mối quan hệ nghiêm túc"/>
                            <ComboBoxItem Content="Tìm bạn bè"/>
                            <ComboBoxItem Content="Không ràng buộc"/>
                            <ComboBoxItem Content="Chưa xác định"/>
                        </ComboBox>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Lối sống" Text="{Binding ProfileLifestyle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Vibe / Tính cách" Text="{Binding ProfileVibe, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Khoảng cách tìm kiếm tối đa (km)" Text="{Binding ProfileMaxDistance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </Grid>

                    <TextBox materialDesign:HintAssist.Hint="Sở thích (ngăn cách bởi dấu phẩy)" Text="{Binding ProfileInterests, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,20"/>
                    <TextBox materialDesign:HintAssist.Hint="Giá trị sống (ngăn cách bởi dấu phẩy)" Text="{Binding ProfileValues, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,30"/>
                    
                    <Button Content="Lưu Thay Đổi" Command="{Binding SaveProfileCommand}" Background="#E6005C" BorderBrush="Transparent" Height="45" FontSize="16"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <!-- MESSAGES AREA -->
        <Grid Grid.Column="1" Visibility="{Binding IsMessagesVisible, Converter={StaticResource BoolToVis}}" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Matches & Inbox List -->
            <Border Grid.Column="0" BorderBrush="#F3F4F6" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tương hợp mới" FontSize="18" FontWeight="Bold" Foreground="#E6005C" Margin="20,20,20,10"/>
                    
                    <!-- Horizontal Matches (Tinder Style) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="20,0,0,10">
                        <ItemsControl ItemsSource="{Binding Matches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,15,0" Width="70" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel.InputBindings>
                                        <Border Width="64" Height="64" CornerRadius="32" BorderBrush="#E6005C" BorderThickness="2" Padding="2">
                                            <Border CornerRadius="30">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Partner.AvatarUrl, TargetNullValue='pack://application:,,,/Resources/default-avatar.jpg'}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding Partner.FullName}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Vertical Inbox -->
                    <TextBlock Grid.Row="2" Text="Tin nhắn" FontSize="18" FontWeight="Bold" Foreground="#E6005C" Margin="20,10,20,10" VerticalAlignment="Top"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedMatch}" Background="Transparent" BorderThickness="0" Margin="0,40,0,0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Partner.AvatarUrl, TargetNullValue='pack://application:,,,/Resources/default-avatar.jpg'}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Partner.FullName}" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                                        <TextBlock Text="{Binding LastMessage.Content, FallbackValue='Bắt đầu trò chuyện'}" FontSize="13" Foreground="#6B7280" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                    </StackPanel>
                                    
                                    <Border Grid.Column="2" Visibility="{Binding UnreadCount, Converter={StaticResource BoolToVis}}" Background="#E6005C" CornerRadius="10" MinWidth="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Chat Box -->
            <Grid Grid.Column="1" Background="#FFF5F8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Header -->
                <Border Grid.Row="0" Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding SelectedMatch.Partner.AvatarUrl, TargetNullValue='pack://application:,,,/Resources/default-avatar.jpg'}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedMatch.Partner.FullName}" FontSize="18" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock Text="Đang hoạt động" FontSize="12" Foreground="#10B981"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding UnmatchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#EF4444" Foreground="#EF4444" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountCancel" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Unmatch"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding BlockCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="#EF4444" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BlockHelper" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Block"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Message History -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10">
                    <ItemsControl ItemsSource="{Binding CurrentMessages}" Margin="20,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5">
                                    <Border CornerRadius="15" Padding="12,8" MaxWidth="300">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="Background" Value="#E6005C"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Image Source="{Binding ImageUrl, TargetNullValue={x:Null}}" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" Stretch="Uniform" MaxHeight="200" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding Content}" Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1F2937"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Input Area -->
                <Border Grid.Row="2" Background="White" Padding="15" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Command="{Binding SendImageCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#6B7280" Width="45" Height="45" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ImageOutline" Width="24" Height="24"/>
                        </Button>
                        
                        <TextBox Grid.Column="1" Text="{Binding MessageDraft, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nhập tin nhắn..." Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="45" VerticalContentAlignment="Center" Background="#F9FAFB"/>
                        
                        <Button Grid.Column="2" Command="{Binding SendMessageCommand}" Style="{StaticResource MaterialDesignFloatingActionLightButton}" Width="45" Height="45" Background="#E6005C" BorderBrush="#E6005C" Margin="10,0,0,0" Foreground="White">
                            <materialDesign:PackIcon Kind="Send" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Default Placeholder when no Match is selected -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatActive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <materialDesign:PackIcon Kind="MessageOutline" Width="100" Height="100" Foreground="#F3F4F6" HorizontalAlignment="Center"/>
                <TextBlock Text="Chọn một tương hợp để bắt đầu trò chuyện" FontSize="18" Foreground="#9CA3AF" FontWeight="Medium" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
