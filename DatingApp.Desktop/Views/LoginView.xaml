<UserControl x:Class="DatingApp.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DatingApp.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#FFE1EB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="450" Padding="40" Background="White" CornerRadius="16" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <Grid>
                <!-- PANEL 1: LOGIN -->
                <StackPanel Visibility="{Binding IsLoginPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Aura Premium" FontSize="28" FontWeight="Bold" Foreground="#E6005C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Đăng nhập để kết nối" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Email" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,20" FontSize="16"/>

                    <PasswordBox x:Name="PasswordBox" 
                                 materialDesign:HintAssist.Hint="Mật khẩu" 
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" 
                                 Margin="0,0,0,10" FontSize="16"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- Remember Me & Forgot Password Grid -->
                    <Grid Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsRememberMe}" Content="Ghi nhớ đăng nhập" Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding ShowForgotPasswordCommand}" 
                                Content="Quên mật khẩu?" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="Gray" FontSize="13" 
                                HorizontalAlignment="Right" Padding="0" Height="25" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                    <Button Command="{Binding LoginCommand}" 
                            Content="Đăng nhập" 
                            Height="50" FontSize="16" FontWeight="SemiBold"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#FF5C9A" Foreground="White" BorderBrush="Transparent" Margin="0,10,0,10"/>

                    <Button Command="{Binding ShowRegisterStep1Command}" 
                            Content="Chưa có tài khoản? Đăng ký ngay" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E6005C" HorizontalAlignment="Center"/>

                    <TextBlock Text="Đang xử lý..." Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- PANEL 2: REGISTER STEP 1 (Email / Password) -->
                <StackPanel Visibility="{Binding IsRegisterStep1Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Tạo tài khoản" FontSize="28" FontWeight="Bold" Foreground="#E6005C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Bước 1: Thông tin đăng nhập" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <TextBox Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Email" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,20" FontSize="16"/>

                    <PasswordBox x:Name="RegisterPasswordBox"
                             materialDesign:HintAssist.Hint="Mật khẩu (ít nhất 6 ký tự)" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" 
                             Margin="0,0,0,10" FontSize="16"
                             PasswordChanged="RegisterPasswordBox_PasswordChanged"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                    <Button Command="{Binding ShowRegisterStep2Command}" 
                            Content="Tiếp tục" 
                            Height="50" FontSize="16" FontWeight="SemiBold"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#FF5C9A" Foreground="White" BorderBrush="Transparent" Margin="0,10,0,10"/>

                    <Button Command="{Binding BackToLoginCommand}" 
                            Content="Quay lại Đăng nhập" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- PANEL 3: REGISTER STEP 2 (Profile Info) -->
                <StackPanel Visibility="{Binding IsRegisterStep2Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Hồ sơ cá nhân" FontSize="28" FontWeight="Bold" Foreground="#E6005C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Bước 2: Hoàn thiện hồ sơ" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBox Text="{Binding RegisterFullName, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Họ và Tên" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,20" FontSize="16"/>

                    <DatePicker SelectedDate="{Binding RegisterDOB}" 
                                materialDesign:HintAssist.Hint="Ngày sinh" 
                                Style="{StaticResource MaterialDesignFloatingHintDatePicker}" 
                                Margin="0,0,0,20" FontSize="16"/>

                    <ComboBox SelectedIndex="{Binding RegisterGender}" 
                              materialDesign:HintAssist.Hint="Giới tính" 
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                              Margin="0,0,0,20" FontSize="16">
                        <ComboBoxItem Content="Nam"/>
                        <ComboBoxItem Content="Nữ"/>
                        <ComboBoxItem Content="Khác"/>
                    </ComboBox>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                    <Button Command="{Binding CompleteRegisterCommand}" 
                            Content="Hoàn tất Đăng ký" 
                            Height="50" FontSize="16" FontWeight="SemiBold"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#FF5C9A" Foreground="White" BorderBrush="Transparent" Margin="0,10,0,10"/>

                    <Button Command="{Binding ShowRegisterStep1Command}" 
                            Content="Quay lại Bước 1" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Gray" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Đang xử lý..." Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- PANEL 4: OTP VERIFICATION -->
                <StackPanel Visibility="{Binding IsOtpVerificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Xác minh Email" FontSize="28" FontWeight="Bold" Foreground="#E6005C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Vui lòng nhập mã OTP 6 số đã được gửi tới email của bạn:" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="{Binding OtpTargetEmail}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBox Text="{Binding OtpVerificationCode, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Mã OTP (6 chữ số)" 
                             MaxLength="6"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             HorizontalContentAlignment="Center"
                             Margin="0,0,0,15" FontSize="20" FontWeight="Bold"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                    <Button Command="{Binding VerifyOtpCommand}" 
                            Content="Xác minh tài khoản" 
                            Height="50" FontSize="16" FontWeight="SemiBold"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#E6005C" Foreground="White" BorderBrush="Transparent" Margin="0,10,0,10"/>

                    <Grid Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ResendOtpCommand}" 
                                Content="Gửi lại mã OTP" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E6005C" HorizontalAlignment="Left" Padding="0"/>
                        <Button Grid.Column="1" Command="{Binding BackToLoginCommand}" 
                                Content="Quay lại" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="Gray" HorizontalAlignment="Right" Padding="0"/>
                    </Grid>

                    <TextBlock Text="Đang xử lý..." Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- PANEL 5: FORGOT PASSWORD -->
                <StackPanel Visibility="{Binding IsForgotPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Quên mật khẩu" FontSize="28" FontWeight="Bold" Foreground="#E6005C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Nhập email của bạn để nhận mã phục hồi mật khẩu:" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBox Text="{Binding ForgotEmail, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Email tài khoản" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,20" FontSize="16"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                    <Button Command="{Binding SendResetLinkCommand}" 
                            Content="Gửi mã phục hồi" 
                            Height="50" FontSize="16" FontWeight="SemiBold"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#FF5C9A" Foreground="White" BorderBrush="Transparent" Margin="0,10,0,10"/>

                    <Button Command="{Binding BackToLoginCommand}" 
                            Content="Quay lại Đăng nhập" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Gray" HorizontalAlignment="Center"/>

                    <TextBlock Text="Đang gửi..." Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- PANEL 6: RESET PASSWORD -->
                <StackPanel Visibility="{Binding IsResetPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Đặt lại mật khẩu" FontSize="28" FontWeight="Bold" Foreground="#E6005C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Nhập mã phục hồi (Token) và mật khẩu mới:" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBox Text="{Binding ResetToken, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Mã phục hồi (Token)" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,15" FontSize="15"/>

                    <TextBox Text="{Binding ResetNewPassword, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Mật khẩu mới (ít nhất 6 ký tự)" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,15" FontSize="16"/>

                    <TextBox Text="{Binding ResetConfirmPassword, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Xác nhận mật khẩu mới" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,15" FontSize="16"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                    <Button Command="{Binding ResetPasswordCommand}" 
                            Content="Xác nhận mật khẩu mới" 
                            Height="50" FontSize="16" FontWeight="SemiBold"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#E6005C" Foreground="White" BorderBrush="Transparent" Margin="0,10,0,10"/>

                    <Button Command="{Binding BackToLoginCommand}" 
                            Content="Hủy bỏ &amp; Quay lại" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Gray" HorizontalAlignment="Center"/>

                    <TextBlock Text="Đang xử lý..." Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
