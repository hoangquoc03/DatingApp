<UserControl x:Class="DatingApp.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:DatingApp.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Background="#F0F2F5">
        <!-- Ethereal soft background glows -->
        <Ellipse Width="600" Height="600" Fill="#FF1A75" Opacity="0.06" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-200">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="700" Height="700" Fill="#FF6EA7" Opacity="0.06" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-250,-250,0">
            <Ellipse.Effect>
                <BlurEffect Radius="180"/>
            </Ellipse.Effect>
        </Ellipse>

        <Border Width="460" Style="{StaticResource PremiumCard}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid>
                <!-- PANEL 1: LOGIN -->
                <StackPanel Visibility="{Binding IsLoginPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Aura Dating" FontSize="30" FontWeight="Black" Foreground="{StaticResource FbBrandSolid}" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI, Arial, sans-serif"/>
                    <TextBlock Text="Đăng nhập để kết nối" FontSize="15" FontWeight="Medium" Foreground="{StaticResource FbTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Email" 
                             Style="{StaticResource PremiumTextBox}" 
                             Margin="0,0,0,16"/>

                    <PasswordBox x:Name="PasswordBox" 
                                 materialDesign:HintAssist.Hint="Mật khẩu" 
                                 Style="{StaticResource PremiumPasswordBox}" 
                                 Margin="0,0,0,12"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- Remember Me & Forgot Password Grid -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsRememberMe}" Content="Ghi nhớ đăng nhập" Foreground="{StaticResource FbTextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding ShowForgotPasswordCommand}" 
                                Content="Quên mật khẩu?" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource FbTextSecondary}" FontSize="13" FontWeight="SemiBold"
                                HorizontalAlignment="Right" Padding="0" Height="25" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="13" FontWeight="SemiBold"/>

                    <Button Command="{Binding LoginCommand}" 
                            Content="Đăng nhập" 
                            Style="{StaticResource PremiumButton}"
                            Margin="0,0,0,12"/>

                    <Button Command="{Binding ShowRegisterStep1Command}" 
                            Content="Chưa có tài khoản? Đăng ký ngay" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource FbBrandSolid}" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <TextBlock Text="Đang xử lý..." Foreground="{StaticResource FbTextSecondary}" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- PANEL 2: REGISTER STEP 1 (Email / Password) -->
                <StackPanel Visibility="{Binding IsRegisterStep1Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Tạo tài khoản" FontSize="30" FontWeight="Black" Foreground="{StaticResource FbBrandSolid}" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI, Arial, sans-serif"/>
                    <TextBlock Text="Bước 1: Thông tin đăng nhập" FontSize="15" FontWeight="Medium" Foreground="{StaticResource FbTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <TextBox Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Email" 
                             Style="{StaticResource PremiumTextBox}" 
                             Margin="0,0,0,16"/>

                    <PasswordBox x:Name="RegisterPasswordBox"
                                 materialDesign:HintAssist.Hint="Mật khẩu (ít nhất 6 ký tự)" 
                                 Style="{StaticResource PremiumPasswordBox}" 
                                 Margin="0,0,0,16"
                                 PasswordChanged="RegisterPasswordBox_PasswordChanged"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="13" FontWeight="SemiBold"/>

                    <Button Command="{Binding ShowRegisterStep2Command}" 
                            Content="Tiếp tục" 
                            Style="{StaticResource PremiumButton}"
                            Margin="0,0,0,12"/>

                    <Button Command="{Binding BackToLoginCommand}" 
                            Content="Quay lại Đăng nhập" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource FbTextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- PANEL 3: REGISTER STEP 2 (Profile Info) -->
                <StackPanel Visibility="{Binding IsRegisterStep2Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Hồ sơ cá nhân" FontSize="30" FontWeight="Black" Foreground="{StaticResource FbBrandSolid}" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI, Arial, sans-serif"/>
                    <TextBlock Text="Bước 2: Hoàn thiện hồ sơ" FontSize="15" FontWeight="Medium" Foreground="{StaticResource FbTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <TextBox Text="{Binding RegisterFullName, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Họ và Tên" 
                             Style="{StaticResource PremiumTextBox}" 
                             Margin="0,0,0,16"/>

                    <DatePicker SelectedDate="{Binding RegisterDOB}" 
                                materialDesign:HintAssist.Hint="Ngày sinh" 
                                Style="{StaticResource PremiumDatePicker}" 
                                Margin="0,0,0,16"/>

                    <ComboBox SelectedIndex="{Binding RegisterGender}" 
                              materialDesign:HintAssist.Hint="Giới tính" 
                              Style="{StaticResource PremiumComboBox}" 
                              Margin="0,0,0,16">
                        <ComboBoxItem Content="Nam"/>
                        <ComboBoxItem Content="Nữ"/>
                        <ComboBoxItem Content="Khác"/>
                    </ComboBox>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="13" FontWeight="SemiBold"/>

                    <Button Command="{Binding CompleteRegisterCommand}" 
                            Content="Hoàn tất Đăng ký" 
                            Style="{StaticResource PremiumButton}"
                            Margin="0,0,0,12"/>

                    <Button Command="{Binding ShowRegisterStep1Command}" 
                            Content="Quay lại Bước 1" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource FbTextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Đang xử lý..." Foreground="{StaticResource FbTextSecondary}" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- PANEL 4: OTP VERIFICATION -->
                <StackPanel Visibility="{Binding IsOtpVerificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Xác minh Email" FontSize="30" FontWeight="Black" Foreground="{StaticResource FbBrandSolid}" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI, Arial, sans-serif"/>
                    <TextBlock Text="Vui lòng nhập mã OTP 6 số đã được gửi tới email:" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="{StaticResource FbTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding OtpTargetEmail}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource FbTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBox Text="{Binding OtpVerificationCode, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Mã OTP (6 chữ số)" 
                             MaxLength="6"
                             Style="{StaticResource PremiumTextBox}" 
                             HorizontalContentAlignment="Center"
                             Margin="0,0,0,16" FontSize="22" FontWeight="Bold"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="13" FontWeight="SemiBold"/>

                    <Button Command="{Binding VerifyOtpCommand}" 
                            Content="Xác minh tài khoản" 
                            Style="{StaticResource PremiumButton}"
                            Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ResendOtpCommand}" 
                                Content="Gửi lại mã OTP" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource FbBrandSolid}" FontWeight="Bold" HorizontalAlignment="Left" Padding="0"/>
                        <Button Grid.Column="1" Command="{Binding BackToLoginCommand}" 
                                Content="Quay lại" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource FbTextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Right" Padding="0"/>
                    </Grid>

                    <TextBlock Text="Đang xử lý..." Foreground="{StaticResource FbTextSecondary}" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- PANEL 5: FORGOT PASSWORD -->
                <StackPanel Visibility="{Binding IsForgotPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Quên mật khẩu" FontSize="30" FontWeight="Black" Foreground="{StaticResource FbBrandSolid}" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI, Arial, sans-serif"/>
                    <TextBlock Text="Nhập email để nhận mã phục hồi mật khẩu:" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="{StaticResource FbTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <TextBox Text="{Binding ForgotEmail, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Email tài khoản" 
                             Style="{StaticResource PremiumTextBox}" 
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="13" FontWeight="SemiBold"/>

                    <Button Command="{Binding SendResetLinkCommand}" 
                            Content="Gửi mã phục hồi" 
                            Style="{StaticResource PremiumButton}"
                            Margin="0,0,0,12"/>

                    <Button Command="{Binding BackToLoginCommand}" 
                            Content="Quay lại Đăng nhập" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource FbTextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                    <TextBlock Text="Đang gửi..." Foreground="{StaticResource FbTextSecondary}" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- PANEL 6: RESET PASSWORD -->
                <StackPanel Visibility="{Binding IsResetPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Đặt lại mật khẩu" FontSize="30" FontWeight="Black" Foreground="{StaticResource FbBrandSolid}" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI, Arial, sans-serif"/>
                    <TextBlock Text="Nhập mã phục hồi và mật khẩu mới:" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="{StaticResource FbTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <TextBox Text="{Binding ResetToken, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Mã phục hồi (Token)" 
                             Style="{StaticResource PremiumTextBox}" 
                             Margin="0,0,0,12" FontSize="14"/>

                    <TextBox Text="{Binding ResetNewPassword, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Mật khẩu mới (ít nhất 6 ký tự)" 
                             Style="{StaticResource PremiumTextBox}" 
                             Margin="0,0,0,12"/>

                    <TextBox Text="{Binding ResetConfirmPassword, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Xác nhận mật khẩu mới" 
                             Style="{StaticResource PremiumTextBox}" 
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="13" FontWeight="SemiBold"/>

                    <Button Command="{Binding ResetPasswordCommand}" 
                            Content="Xác nhận mật khẩu mới" 
                            Style="{StaticResource PremiumButton}"
                            Margin="0,0,0,12"/>

                    <Button Command="{Binding BackToLoginCommand}" 
                            Content="Hủy bỏ &amp; Quay lại" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource FbTextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                    <TextBlock Text="Đang xử lý..." Foreground="{StaticResource FbTextSecondary}" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10,0,0" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
